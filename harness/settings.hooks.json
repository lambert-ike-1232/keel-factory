{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node /ABSOLUTE/PATH/TO/harness/hooks/block-no-verify.js" }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node /ABSOLUTE/PATH/TO/harness/hooks/config-protection.js" }
        ]
      },
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Glob|Grep|Bash",
        "hooks": [
          { "type": "command", "command": "python3 /ABSOLUTE/PATH/TO/harness/hooks/data-boundary-guard.py" }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node /ABSOLUTE/PATH/TO/harness/hooks/cost-tracker.js" }
        ]
      }
    ]
  }
}
